{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/write-native-revision.mjs && pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/policies.html", "destination": "/", "permanent": true},
    {"source": "/policies", "destination": "/", "permanent": false}
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?route=:path*"
    },
    {
      "source": "/allowances",
      "destination": "/index.html"
    },
    {
      "source": "/delegate",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.testnet.solana.com https://horizon-testnet.stellar.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false, "prod": false, "fix/policy-recovery-stop-all": false,
      "agentool/adk-owner-handoff-app": false,
      "codex/spl-delegate-x402": false,
      "fix/paysh-staging-review-20261022": false
    }
  },
  "functions": {
    "api/proxy.ts": {
      "maxDuration": 200
    }
  }
}
