# Server only. Browser uses same-origin /api.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PORT=8080
DATA_PATH=.data/workspace.json
# Required on Vercel. Use a dedicated environment database.
# DATABASE_URL=postgresql://...
# COOKIE_SECURE=1

# Direct Google Gemini is primary (server only).
GEMINI_API_KEY=
# Optional backup for the same Gemini model through Vercel AI Gateway.
# Verify access to the exact Gemini model. Never use VITE_* keys.
# Set to 1 only after model access and a real generation check pass.
AI_GATEWAY_BACKUP_ENABLED=0
AI_GATEWAY_API_KEY=
# Server-only preference evaluator; JEV_API_KEY is accepted as an alias.
TYPESAFE_API_KEY=
# Optional per-network RPC endpoints. Every response is checked against its network genesis.
# For Helius Devnet, set this server-only value to https://devnet.helius-rpc.com/?api-key=YOUR_KEY.
# Keep it out of VITE_* variables; use a branch-scoped encrypted Preview value on Vercel.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Optional six-decimal classic SPL Devnet test mint; defaults to Devnet USDC.
SOLANA_DEVNET_TOKEN_MINT=

SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
# Optional six-decimal classic SPL test mint on Testnet (not Circle USDC).
# Without this, Testnet drafts work and approval is disabled.
SOLANA_TESTNET_TOKEN_MINT=
# Optional public build-time UI scope for an isolated Testnet-only preview.
# VITE_TESTNET_ONLY=1

# Legacy optional hosted control only; ignored by the MVP.
# Existing deployed credentials stay unchanged. Do not enable starts.
# ALLOWIT_RUNNER_KEY=

# Native custody v2 (?native=1), separate from owner-signed allowances.
# Configure these on the Rust BACKEND, not in browser variables.
# The frontend reads public metadata from /api/native/config and /api/native/release.
# ABI v2 needs a matching v2 deployment; an older deployment cannot be reused.
# ALLOWIT_NATIVE_NETWORK=solana:testnet
# ALLOWIT_NATIVE_DEPLOYMENT_JSON={"network":"solana:testnet","sourceBundle":"793db01595fbcb15503914744e49b45f470e9ca1d2805aceadeac00a0d843fc7","policy":"...","policyData":"...","custody":"..."}
# ALLOWIT_NATIVE_MINT=
# ALLOWIT_NATIVE_EXECUTOR=
# ALLOWIT_NATIVE_AUTHORITY=
# The matching authority signing key is configured privately on the backend only.

# Frontend server-only proxy configuration. Never use VITE_* for credentials.
ALLOWIT_API_MODE=rust
ALLOWIT_BACKEND_ORIGIN=http://127.0.0.1:8080
ALLOWIT_BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:8080
# Railway containers may set this and both values above to the same exact
# http://<service>.railway.internal:<port> origin. It is rejected on Vercel.
# ALLOWIT_PRIVATE_API_ORIGIN=
# Loopback is local-only and is forbidden on Vercel.
ALLOWIT_PROXY_ALLOW_LOOPBACK=1
# Optional Preview deployment-protection credential. Not application authority.
# ALLOWIT_BACKEND_PROTECTION_BYPASS=
# Configure database, model keys, native mint/deployment and APP_ORIGINS in the
# canonical allowit-hq/allowit-engine backend, separately for Preview/Production.
